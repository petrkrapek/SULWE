{
  "name": "shrnuti-stranky",
  "version": "0.1.0",
  "private": true,
  "description": "Rozšíření do Chromu, které pomocí AI shrne aktuální webovou stránku.",
  "scripts": {
    "build": "esbuild src/popup.js src/options.js --bundle --format=esm --target=chrome120 --minify --outdir=extension/dist",
    "watch": "npm run build -- --watch",
    "zip": "npm run build && node scripts/zip.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
