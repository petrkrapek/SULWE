{
  "name": "shrnu-to",
  "private": true,
  "description": "Rozšíření do Chromu, které pomocí AI shrne aktuální webovou stránku.",
  "license": "Apache-2.0",
  "author": "Petr Křápek",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/popup.js src/options.js src/welcome.js src/background.js --bundle --format=esm --target=chrome120 --minify --outdir=extension/dist",
    "watch": "npm run build -- --watch",
    "zip": "npm run build && node scripts/zip.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
